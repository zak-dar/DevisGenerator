<Window x:Class="DevisGenerator.Pages.FormulaireDevisCoproType"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DevisGenerator.Pages"
        xmlns:conv="clr-namespace:DevisGenerator.Converters"
        mc:Ignorable="d"
        Title="Devis - Copropriété"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        MinWidth="520"
        MinHeight="300"
        HorizontalContentAlignment="Stretch"
        Background="#F5F5F5"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:ComboSelectionToVisibilityConverter x:Key="ComboToVis" />

        <!-- Couleurs du thème -->
        <SolidColorBrush x:Key="AccentBrush"       Color="#522900"/>
        <SolidColorBrush x:Key="AccentHoverBrush"  Color="#7A3D00"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#3A1C00"/>
        <SolidColorBrush x:Key="SurfaceBrush"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush"        Color="#E0D6CF"/>
        <SolidColorBrush x:Key="SubtleForeground"   Color="#7A6A60"/>
        <SolidColorBrush x:Key="SectionHeaderBrush" Color="#F0EAE5"/>

        <!-- Label global -->
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="0,0,10,8" />
            <Setter Property="Foreground"        Value="#2E1A0E" />
            <Setter Property="FontSize"          Value="13" />
        </Style>

        <!-- TextBox global -->
        <Style TargetType="TextBox">
            <Setter Property="Height"                   Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding"                  Value="6,0" />
            <Setter Property="BorderBrush"              Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness"          Value="1" />
            <Setter Property="Background"               Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground"               Value="#2E1A0E" />
            <Setter Property="FontSize"                 Value="13" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#F0EAE5" />
                    <Setter Property="Foreground" Value="{StaticResource SubtleForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox global -->
        <Style TargetType="ComboBox">
            <Setter Property="Height"                   Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding"                  Value="6,0" />
            <Setter Property="BorderBrush"              Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness"          Value="1" />
            <Setter Property="Background"               Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground"               Value="#2E1A0E" />
            <Setter Property="FontSize"                 Value="13" />
        </Style>

        <!-- CheckBox global -->
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment"        Value="Center" />
            <Setter Property="Foreground"               Value="#2E1A0E" />
            <Setter Property="FontSize"                 Value="13" />
        </Style>

        <!-- Bouton principal (accent) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"               Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground"               Value="White" />
            <Setter Property="BorderThickness"          Value="0" />
            <Setter Property="Padding"                  Value="16,6" />
            <Setter Property="FontSize"                 Value="13" />
            <Setter Property="FontWeight"               Value="SemiBold" />
            <Setter Property="Cursor"                   Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#C4B8B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton secondaire (neutre) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="White" />
            <Setter Property="Foreground"      Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush"     Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="16,6" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0EAE5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0D6CF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton photo (discret) -->
        <Style x:Key="PhotoButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#F0EAE5" />
            <Setter Property="Foreground"      Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="10,4" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0D6CF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton "Supprimer" ligne tarif -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#C0392B" />
            <Setter Property="Foreground"      Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="10,3" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#A93226"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cellule TextBox grille tarifaire -->
        <Style x:Key="TarifCellTextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin"                   Value="0,0,8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height"                   Value="28" />
            <Setter Property="Padding"                  Value="6,0" />
            <Setter Property="BorderBrush"              Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness"          Value="1" />
            <Setter Property="Background"               Value="{StaticResource SurfaceBrush}" />
        </Style>
    </Window.Resources>

    <Border Background="#F5F5F5">
        <DockPanel>

            <!-- Bannière d'en-tête -->
            <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="20,14">
                <TextBlock Text="Devis — Copropriété"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI" />
            </Border>

            <!-- Corps du formulaire -->
            <Grid Margin="20" Name="grid1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

        <!-- Nom du client -->
        <Label x:Name="clientNomLabel"
             Content="Nom du client :"
             Grid.Row="0" Grid.Column="0"
             Target="{Binding ElementName=clientNom}"/>
        <TextBox x:Name="clientNom"
               Grid.Row="0" Grid.Column="1"
               MinWidth="250"
               Margin="0,0,0,8"
               ToolTip="Saisissez le nom du client"/>

        <!-- Numéro d'opportunité -->
        <Label x:Name="numeroOpportuniteLabel"
             Content="Numéro d'opportunité :"
             Grid.Row="1" Grid.Column="0"
             Target="{Binding ElementName=numeroOpportunite}"/>
        <TextBox x:Name="numeroOpportunite"
               Grid.Row="1" Grid.Column="1"
               MinWidth="250"
               Margin="0,0,0,8"
               ToolTip="Saisissez le numéro d'opportunité"/>

        <!-- Nom d'opportunité -->
        <Label x:Name="nomOpportuniteLabel"
             Content="Nom d'opportunité :"
             Grid.Row="2" Grid.Column="0"
             Target="{Binding ElementName=nomOpportunite}"/>
        <TextBox x:Name="nomOpportunite"
               Grid.Row="2" Grid.Column="1"
               MinWidth="250"
               Margin="0,0,0,8"
               ToolTip="Saisissez le nom d'opportunité"/>

        <!-- Adresse du client -->
        <Label x:Name="clientAdresseLabel"
             Content="Adresse du client :"
             Grid.Row="3" Grid.Column="0"
             Target="{Binding ElementName=clientAdresse}"/>
        <TextBox x:Name="clientAdresse"
               Grid.Row="3" Grid.Column="1"
               MinWidth="250"
               Margin="0,0,0,8"
               ToolTip="Saisissez l'adresse du client"/>

        <!-- Champ additionnel en lecture seule (ex : copie) -->
        <Label x:Name="referenceDevisClientLabel"
             Content="Référence devis client :"
             Grid.Row="4" Grid.Column="0"
             Target="{Binding ElementName=referenceDevisClient}"/>
        <TextBox x:Name="referenceDevisClient"
               Grid.Row="4" Grid.Column="1"
               MinWidth="250"
               Margin="0,0,0,8"/>

        <!-- E-mail client -->
        <Label x:Name="emailClientLabel"
             Content="E-mail client :"
             Grid.Row="5" Grid.Column="0"
             Target="{Binding ElementName=emailClientTextBox}"/>
        <TextBox x:Name="emailClientTextBox"
               Grid.Row="5" Grid.Column="1"
               MinWidth="250"
               Margin="0,0,0,8"
               ToolTip="Saisissez l'adresse e-mail du client"/>

        <!-- Sections (scrollable) -->
        <ScrollViewer Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="0,4,0,0" x:Name="SectionsPanel">

                <!-- Section: Hall d'entrée -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Hall d'entrée" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        </DockPanel>

                        <Grid Visibility="{Binding IsChecked, ElementName=chkShowHall, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label x:Name="nettoyageMarchesLabel" Grid.Row="0" Grid.Column="0" Content="Nettoyage des marches et contremarches d'accès au hall d'entrée"/>
                            <CheckBox x:Name="nettoyageMarchesCheckbox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" />

                            <Label x:Name="nettoyageCuivreLabel" Grid.Row="1" Grid.Column="0" Content="Nettoyage des cuivres"/>
                            <CheckBox x:Name="nettoyageCuivreCheckbox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" />

                            <Label x:Name="nettoyagePorteTambourLabel" Grid.Row="2" Grid.Column="0" Content="Nettoyage de la porte à tambour"/>
                            <CheckBox x:Name="nettoyagePorteTambourCheckbox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" />

                            <Label x:Name="frequenceHallEntreeLabel" Grid.Row="3" Grid.Column="0" Content="Fréquence de nettoyage"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBox x:Name="frenquenceHallEntree" MinWidth="200" Height="25" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="1 fois/mois"/>
                                    <ComboBoxItem Content="Tous les 15 jours"/>
                                    <ComboBoxItem Content="1 fois/semaine"/>
                                    <ComboBoxItem Content="2 fois/semaine"/>
                                    <ComboBoxItem Content="3 fois/semaine"/>
                                    <ComboBoxItem Content="Tous les jours du lundi au samedi"/>
                                    <ComboBoxItem Content="Autre (saisir manuellement)"/>
                                </ComboBox>
                                <TextBox x:Name="frenquenceHallEntree_Manual" Width="140" ToolTip="Saisie manuelle (utilisez si 'Autre')" Visibility="{Binding SelectedItem, ElementName=frenquenceHallEntree, Converter={StaticResource ComboToVis}}"/>
                            </StackPanel>

                            <Button x:Name="btnPhotoHall" Grid.Row="4" Grid.Column="0" Content="📷 Insérer une photo" MaxWidth="200" MinWidth="140" Style="{StaticResource PhotoButtonStyle}" Click="BtnPhotoHall_Click" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Ascenceur -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Ascenseur  " FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <CheckBox x:Name="chkShowAscenceur" Content="Afficher" DockPanel.Dock="Right" IsChecked="True" />
                        </DockPanel>

                        <Grid Visibility="{Binding IsChecked, ElementName=chkShowAscenceur, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label x:Name="frenquenceAscenceurLabel" Grid.Row="0" Grid.Column="0" Content="Fréquence de nettoyage"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                                <ComboBox x:Name="frenquenceAscenceur" MinWidth="200" Height="25" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="1 fois/mois"/>
                                    <ComboBoxItem Content="Tous les 15 jours"/>
                                    <ComboBoxItem Content="1 fois/semaine"/>
                                    <ComboBoxItem Content="2 fois/semaine"/>
                                    <ComboBoxItem Content="3 fois/semaine"/>
                                    <ComboBoxItem Content="Tous les jours du lundi au samedi"/>
                                    <ComboBoxItem Content="Autre (saisir manuellement)"/>
                                </ComboBox>
                                <TextBox x:Name="frenquenceAscenceur_Manual" Width="140" ToolTip="Saisie manuelle (utilisez si 'Autre')" Visibility="{Binding SelectedItem, ElementName=frenquenceAscenceur, Converter={StaticResource ComboToVis}}"/>
                            </StackPanel>
                            <Button x:Name="btnPhotoAscenceur" Grid.Row="1" Grid.Column="0" Content="📷 Insérer une photo" MaxWidth="200" MinWidth="140" Style="{StaticResource PhotoButtonStyle}" Click="BtnPhotoAscenceur_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Cages d'escaliers -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Cages d'escaliers" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        </DockPanel>

                        <Grid Visibility="{Binding IsChecked, ElementName=chkShowCageDEscaliers, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label x:Name="frenquenceCageDEscaliersLabel" Grid.Row="0" Grid.Column="0" Content="Fréquence de nettoyage"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                                <ComboBox x:Name="frenquenceCageDEscaliers" MinWidth="200" Height="25" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Aucune"/>
                                    <ComboBoxItem Content="1 fois/mois"/>
                                    <ComboBoxItem Content="Tous les 15 jours"/>
                                    <ComboBoxItem Content="1 fois/semaine"/>
                                    <ComboBoxItem Content="2 fois/semaine"/>
                                    <ComboBoxItem Content="3 fois/semaine"/>
                                    <ComboBoxItem Content="Tous les jours du lundi au samedi"/>
                                    <ComboBoxItem Content="Autre (saisir manuellement)"/>
                                </ComboBox>
                                <TextBox x:Name="frenquenceCageDEscaliers_Manual" Width="140" ToolTip="Saisie manuelle (utilisez si 'Autre')" Visibility="{Binding SelectedItem, ElementName=frenquenceCageDEscaliers, Converter={StaticResource ComboToVis}}"/>
                            </StackPanel>

                            <Button x:Name="btnPhotoCageEscaliers" Grid.Row="1" Grid.Column="0" Content="📷 Insérer une photo" MaxWidth="200" MinWidth="140" Style="{StaticResource PhotoButtonStyle}" Click="BtnPhotoCageEscaliers_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Paliers -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Paliers" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        </DockPanel>

                        <Grid Visibility="{Binding IsChecked, ElementName=chkShowPaliers, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label x:Name="frenquencePaliersLabel" Grid.Row="0" Grid.Column="0" Content="Fréquence de nettoyage"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                                <ComboBox x:Name="frenquencePaliers" MinWidth="200" Height="25" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Aucune"/>
                                    <ComboBoxItem Content="1 fois/mois"/>
                                    <ComboBoxItem Content="Tous les 15 jours"/>
                                    <ComboBoxItem Content="1 fois/semaine"/>
                                    <ComboBoxItem Content="2 fois/semaine"/>
                                    <ComboBoxItem Content="3 fois/semaine"/>
                                    <ComboBoxItem Content="Tous les jours du lundi au samedi"/>
                                    <ComboBoxItem Content="Autre (saisir manuellement)"/>
                                </ComboBox>
                                <TextBox x:Name="frenquencePaliers_Manual" Width="140" ToolTip="Saisie manuelle (utilisez si 'Autre')" Visibility="{Binding SelectedItem, ElementName=frenquencePaliers, Converter={StaticResource ComboToVis}}"/>
                            </StackPanel>

                            <Button x:Name="btnPhotoPaliers" Grid.Row="1" Grid.Column="0" Content="📷 Insérer une photo" MaxWidth="200" MinWidth="140" Style="{StaticResource PhotoButtonStyle}" Click="BtnPhotoPaliers_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Caves et accès aux caves -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Caves et accès aux caves  " FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <CheckBox x:Name="chkShowCavesAcces" Content="Afficher" DockPanel.Dock="Right" IsChecked="True" />
                        </DockPanel>

                        <Grid Visibility="{Binding IsChecked, ElementName=chkShowCavesAcces, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label x:Name="frequenceCavesEtAccesCavesLabel" Grid.Column="0" Content="Fréquence de nettoyage"/>
                            <StackPanel Orientation="Horizontal" Grid.Column="1">
                                <ComboBox x:Name="frenquenceCavesEtAccesCaves" MinWidth="200" Height="25" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="1 fois/mois"/>
                                    <ComboBoxItem Content="Tous les 15 jours"/>
                                    <ComboBoxItem Content="1 fois/semaine"/>
                                    <ComboBoxItem Content="Autre (saisir manuellement)"/>
                                </ComboBox>
                                <TextBox x:Name="frenquenceCavesEtAccesCaves_Manual" Width="140" ToolTip="Saisie manuelle" Visibility="{Binding SelectedItem, ElementName=frenquenceCavesEtAccesCaves, Converter={StaticResource ComboToVis}}"/>
                            </StackPanel>

                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Accès garage -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Accès garage  " FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <CheckBox x:Name="chkShowAccesGarage" Content="Afficher" DockPanel.Dock="Right" IsChecked="True" />
                        </DockPanel>
                        <Grid Visibility="{Binding IsChecked, ElementName=chkShowAccesGarage, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label x:Name="nettoyagePortesAscenceurLabel" Grid.Row="0" Grid.Column="0" Content="Nettoyage des portes d'ascenceur d'acès au garage"/>
                            <CheckBox x:Name="nettoyagePortesAscenceurCheckbox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" />

                            <Label x:Name="nettoyageRailsAscenceurLabel" Grid.Row="1" Grid.Column="0" Content="Nettoyage des rails d'ascenceur"/>
                            <CheckBox x:Name="nettoyageRailsAscenceurCheckbox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" />

                            <Label x:Name="frequenceAccesGarageLabel" Grid.Row="2"  Grid.Column="0" Content="Fréquence de nettoyage"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1">
                                <ComboBox x:Name="frenquenceAccesGarage" MinWidth="200" Height="25" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="1 fois/mois"/>
                                    <ComboBoxItem Content="Tous les 15 jours"/>
                                    <ComboBoxItem Content="1 fois/semaine"/>
                                    <ComboBoxItem Content="Autre (saisir manuellement)"/>
                                </ComboBox>
                                <TextBox x:Name="frenquenceAccesGarage_Manual" Width="140" ToolTip="Saisie manuelle" Visibility="{Binding SelectedItem, ElementName=frenquenceAccesGarage, Converter={StaticResource ComboToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Garage -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Garage  " FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <CheckBox x:Name="chkShowGarage" Content="Afficher" DockPanel.Dock="Right" IsChecked="True" />
                        </DockPanel>

                        <Grid Visibility="{Binding IsChecked, ElementName=chkShowGarage, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label x:Name="enlevementDetritutsFeuillesVoieAccesGarageLabel" Grid.Row="0" Grid.Column="0" Content="Enlèvement des détritus et des feuilles de la voie d'accès aux garages"/>
                            <CheckBox x:Name="enlevementDetritutsFeuillesVoieAccesGarageCheckbox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" />

                            <Label x:Name="frequenceGarageLabel" Grid.Row="1" Grid.Column="0" Content="Fréquence de nettoyage"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1">
                                <ComboBox x:Name="frenquenceGarage" MinWidth="200" Height="25" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="1 fois/mois"/>
                                    <ComboBoxItem Content="Tous les 15 jours"/>
                                    <ComboBoxItem Content="1 fois/semaine"/>
                                    <ComboBoxItem Content="Autre (saisir manuellement)"/>
                                </ComboBox>
                                <TextBox x:Name="frenquenceGarage_Manual" Width="140" ToolTip="Saisie manuelle" Visibility="{Binding SelectedItem, ElementName=frenquenceGarage, Converter={StaticResource ComboToVis}}"/>
                            </StackPanel>

                            <Button x:Name="btnPhotoGarage" Grid.Row="2" Grid.Column="0" Content="📷 Insérer une photo" MaxWidth="200" MinWidth="140" Style="{StaticResource PhotoButtonStyle}" Click="BtnPhotoGarage_Click" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Abords et accès -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Abords et accès  " FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <CheckBox x:Name="chkShowAbords" Content="Afficher" DockPanel.Dock="Right" IsChecked="True" />
                        </DockPanel>

                        <Grid Visibility="{Binding IsChecked, ElementName=chkShowAbords, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label x:Name="frequenceAbordsEtAccesLabel" Grid.Row="0" Grid.Column="0" Content="Fréquence de nettoyage"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                                <ComboBox x:Name="frenquenceAbordsEtAcces" MinWidth="200" Height="25" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="1 fois/mois"/>
                                    <ComboBoxItem Content="Tous les 15 jours"/>
                                    <ComboBoxItem Content="1 fois/semaine"/>
                                    <ComboBoxItem Content="Autre (saisir manuellement)"/>
                                </ComboBox>
                                <TextBox x:Name="frenquenceAbordsEtAcces_Manual" Width="140" ToolTip="Saisie manuelle" Visibility="{Binding SelectedItem, ElementName=frenquenceAbordsEtAcces, Converter={StaticResource ComboToVis}}"/>
                            </StackPanel>

                            <Button x:Name="btnPhotoAbords" Grid.Row="1" Grid.Column="0" Content="📷 Insérer une photo" MaxWidth="200" MinWidth="140" Style="{StaticResource PhotoButtonStyle}" Click="BtnPhotoAbords_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Local conteneurs / vide ordures -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Local conteneurs / vide ordures  " FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <CheckBox x:Name="chkShowLocalConteneurs" Content="Afficher" DockPanel.Dock="Right" IsChecked="True" />
                        </DockPanel>

                        <Grid Visibility="{Binding IsChecked, ElementName=chkShowLocalConteneurs , Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label x:Name="frenquenceLocalConteneurVideOrduresLabel" Grid.Row="0" Grid.Column="0" Content="Fréquence de nettoyage"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                                <ComboBox x:Name="frenquenceLocalConteneurVideOrdures" MinWidth="200" Height="25" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="1 fois/mois"/>
                                    <ComboBoxItem Content="Tous les 15 jours"/>
                                    <ComboBoxItem Content="1 fois/semaine"/>
                                    <ComboBoxItem Content="Autre (saisir manuellement)"/>
                                </ComboBox>
                                <TextBox x:Name="frenquenceLocalConteneurVideOrdures_Manual" Grid.Row="0" Width="140" ToolTip="Saisie manuelle" Visibility="{Binding SelectedItem, ElementName=frenquenceLocalConteneurVideOrdures, Converter={StaticResource ComboToVis}}"/>
                            </StackPanel>
                            <Button x:Name="btnPhotoLocalConteneurVideOrdures" Grid.Row="1" Grid.Column="0" Content="📷 Insérer une photo" MaxWidth="200" MinWidth="140" Style="{StaticResource PhotoButtonStyle}" Click="BtnPhotoPhotoLocalConteneurVideOrdures_Click"/>
                       </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Ordures ménagères -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Ordures ménagères  " FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <CheckBox x:Name="chkShowOrdures" Content="Afficher" DockPanel.Dock="Right" IsChecked="True" />
                        </DockPanel>

                        <Grid Visibility="{Binding IsChecked, ElementName=chkShowOrdures, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label x:Name="sortieConteneurLabel" Grid.Row="0" Grid.Column="0" Content="Sortie des conteneurs"/>
                            <CheckBox x:Name="sortieConteneurCheckbox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" />

                            <Label x:Name="sortieSacsLabel" Grid.Row="1" Grid.Column="0" Content="Sortie des sacs"/>
                            <CheckBox x:Name="sortieSacsCheckbox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" />

                            <Label x:Name="rentreeConteneursLabel" Grid.Row="2" Grid.Column="0" Content="Rentrée des conteneurs"/>
                            <CheckBox x:Name="rentreeConteneursCheckbox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" />

                            <Label x:Name="frenquenceOrduresMenageresLabel" Grid.Row="3"  Grid.Column="0" Content="Fréquence de nettoyage"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1">
                                <ComboBox x:Name="frenquenceOrduresMenageres" MinWidth="200" Height="25" Margin="0,0,8,0" SelectedIndex="0">
                                    <ComboBoxItem Content="6 jours/7"/>
                                    <ComboBoxItem Content="5 jours/7"/>
                                    <ComboBoxItem Content="4 jours/7"/>
                                    <ComboBoxItem Content="3 jours/7"/>
                                    <ComboBoxItem Content="Autre (saisir manuellement)" TabIndex="0"/>
                                </ComboBox>
                                <TextBox x:Name="frenquenceOrduresMenageres_Manual" Width="140" ToolTip="Saisie manuelle" Visibility="{Binding SelectedItem, ElementName=frenquenceOrduresMenageres, Converter={StaticResource ComboToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section: Prestations complémentaires -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Prestations complémentaires  " FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <CheckBox x:Name="chkShowPrestationComplementaires" Content="Afficher" DockPanel.Dock="Right" IsChecked="True" />
                        </DockPanel>

                        <Grid Visibility="{Binding IsChecked, ElementName=chkShowPrestationComplementaires, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.ColumnSpan="2">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label x:Name="coproTravauxLabel" Grid.Column="0" Content="Copro Travaux"/>
                                    <CheckBox x:Name="coproTravauxCheckbox" Grid.Column="1" HorizontalAlignment="Left"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label x:Name="actionNuisiblesLabel" Grid.Column="0" Content="Action nuisibles"/>
                                    <CheckBox x:Name="actionNuisiblesCheckbox" Grid.Column="1" HorizontalAlignment="Left"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label x:Name="relampingLabel" Grid.Column="0" Content="Relamping"/>
                                    <CheckBox x:Name="relampingCheckbox" Grid.Column="1" HorizontalAlignment="Left"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label x:Name="tracabiliteLabel" Grid.Column="0" Content="Traçabilité"/>
                                    <CheckBox x:Name="tracabiliteCheckbox" Grid.Column="1" HorizontalAlignment="Left"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label x:Name="controleQualiteLabel" Grid.Column="0" Content="Contrôle qualité"/>
                                    <CheckBox x:Name="controleQualiteCheckbox" Grid.Column="1" HorizontalAlignment="Left"/>
                                </Grid>

                            </StackPanel>

                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,8" CornerRadius="6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Border Width="4" Background="{StaticResource AccentBrush}" CornerRadius="2" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="Grille tarifaire" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Saisissez au moins une ligne. Le montant est calculé automatiquement." Margin="0,0,0,8" Foreground="{StaticResource SubtleForeground}" FontSize="12"/>

                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Taux de TVA (%) :" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                            <TextBox x:Name="TauxTvaTextBox" Width="60" Text="20"
                                     PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                     DataObject.Pasting="DecimalTextBox_Pasting"
                                     TextChanged="TauxTvaTextBox_TextChanged"
                                     DockPanel.Dock="Left" HorizontalAlignment="Left"/>
                        </DockPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Libellé" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="Prix HT" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="2" Text="TVA" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="3" Text="Prix TTC" FontWeight="SemiBold" Margin="0,0,8,0" />
                        </Grid>

                        <ItemsControl x:Name="TarifItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" Style="{StaticResource TarifCellTextBoxStyle}" Text="{Binding Libelle, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1"
                                                 Style="{StaticResource TarifCellTextBoxStyle}"
                                                 Text="{Binding PrixHT, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewTextInput="DecimalTextBox_PreviewTextInput"
                                                 DataObject.Pasting="DecimalTextBox_Pasting" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding MontantTVA, StringFormat={}{0:N2} €}" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding MontantTTC, StringFormat={}{0:N2} €}" />
                                        <Button Grid.Column="4" Content="Supprimer" Style="{StaticResource DangerButtonStyle}" Tag="{Binding}" Click="SupprimerLigneTarif_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,8,0,0">
                            <Button Content="＋ Ajouter une ligne" MinWidth="130" Style="{StaticResource SecondaryButtonStyle}" Click="AjouterLigneTarif_Click" DockPanel.Dock="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Total TTC :" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="TotalTarifTextBlock" Text="0,00 €" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Surcoût transport d'eau (7,00 € HT / passage)"/>
                            <CheckBox x:Name="chkTransportEau" Grid.Column="1" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Boutons -->
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Annuler" MinWidth="90" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="Button_Click_1"/>
                <Button Content="✔ Enregistrer" MinWidth="110" Style="{StaticResource PrimaryButtonStyle}" Click="Button_Click"/>
            </StackPanel>
        </StackPanel>

            </Grid>
        </DockPanel>
    </Border>
</Window>
