<Window x:Class="DevisGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DevisGenerator"
        mc:Ignorable="d"
        Title="Générateur de Devis"
        Height="450" Width="800"
        Background="#F5F5F5"
        FontFamily="Segoe UI"
        FontSize="13"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <!-- Couleurs du thème -->
        <SolidColorBrush x:Key="AccentBrush"        Color="#522900"/>
        <SolidColorBrush x:Key="AccentHoverBrush"   Color="#7A3D00"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#3A1C00"/>
        <SolidColorBrush x:Key="BorderBrush"        Color="#E0D6CF"/>
        <SolidColorBrush x:Key="SubtleForeground"   Color="#7A6A60"/>

        <!-- Bouton principal (accent) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="24,10"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Bannière d'en-tête -->
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="28,16">
            <StackPanel>
                <TextBlock Text="Générateur de Devis"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Sélectionnez le type de devis à générer"
                           Foreground="#F0D8C8"
                           FontSize="12"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Corps centré -->
        <Grid Background="#F5F5F5">
            <Border Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="40,32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="320">
                <StackPanel HorizontalAlignment="Center">

                    <!-- Icône décorative -->
                    <Border Width="56" Height="56"
                            Background="#F0EAE5"
                            CornerRadius="28"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <TextBlock Text="📄"
                                   FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Type de devis"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#2E1A0E"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Choisissez le modèle à compléter"
                               FontSize="12"
                               Foreground="{StaticResource SubtleForeground}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <Button x:Name="DevisCoproType"
                            Content="Devis Copropriété Type"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="220"
                            Click="DevisCoproType_Click"/>
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
